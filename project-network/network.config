# Defaults for network.sh (every value can be overridden with the flags shown by ./network.sh -h)

# Hyperledger Fabric version of the Docker images (peer/orderer). The CLI tools come from the
# hyperledger-fabric-linux-amd64-3.1.5.tar.gz in the parent folder (see ../tools/).
FABRIC_IMAGE_TAG="3.1.5"

# max number of retries before giving up (-r)
MAX_RETRY=5

# delay in seconds between retried commands (-d)
CLI_DELAY=3

# channel name (-c)
CHANNEL_NAME="projects-channel"

# chaincode name (-ccn), language (-ccl), path (-ccp), version (-ccv)
CC_NAME="projectcc"
CC_SRC_LANGUAGE="javascript"
CC_SRC_PATH="./chaincode/projectcc"
CC_VERSION="1.3"

# chaincode definition sequence: an integer or "auto" (-ccs)
CC_SEQUENCE=auto

# Endorsement policy (-ccep): BOTH organizations must endorse every write
CC_END_POLICY="AND('PlatformMSP.peer','AdminOrgMSP.peer')"
