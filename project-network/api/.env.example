# REST API configuration. Copy to .env (start.sh does this for you) and adjust if you change the network.
# Relative paths are resolved from the api/ folder.

# The API has NO authentication (X-Org only selects whose identity signs). Keep it on localhost, or put it behind
# a reverse proxy / firewall that authenticates callers, before setting HOST=0.0.0.0.
HOST=127.0.0.1
PORT=4000

CHANNEL_NAME=projects-channel
CHAINCODE_NAME=projectcc

# ---- Platform: identity used when the request has "X-Org: platform" (or no X-Org header)
PLATFORM_MSP_ID=PlatformMSP
PLATFORM_PEER_ENDPOINT=localhost:7051
PLATFORM_PEER_HOST_ALIAS=peer0.platform.example.com
PLATFORM_TLS_CERT_PATH=../organizations/peerOrganizations/platform.example.com/tlsca/tlsca.platform.example.com-cert.pem
PLATFORM_CERT_PATH=../organizations/peerOrganizations/platform.example.com/users/User1@platform.example.com/msp/signcerts
PLATFORM_KEY_PATH=../organizations/peerOrganizations/platform.example.com/users/User1@platform.example.com/msp/keystore

# ---- AdminOrg: identity used when the request has "X-Org: admin"
ADMIN_MSP_ID=AdminOrgMSP
ADMIN_PEER_ENDPOINT=localhost:9051
ADMIN_PEER_HOST_ALIAS=peer0.adminorg.example.com
ADMIN_TLS_CERT_PATH=../organizations/peerOrganizations/adminorg.example.com/tlsca/tlsca.adminorg.example.com-cert.pem
ADMIN_CERT_PATH=../organizations/peerOrganizations/adminorg.example.com/users/User1@adminorg.example.com/msp/signcerts
ADMIN_KEY_PATH=../organizations/peerOrganizations/adminorg.example.com/users/User1@adminorg.example.com/msp/keystore

# ---- Health: operations service of each node (plain HTTP, ports published by the compose file)
ORDERER_HEALTH_URL=http://localhost:9443/healthz
PLATFORM_PEER_HEALTH_URL=http://localhost:9444/healthz
ADMIN_PEER_HEALTH_URL=http://localhost:9445/healthz
HEALTH_TIMEOUT_MS=2000
# A 1-block gap between the peers is normal right after a write; it only counts as unhealthy if it lasts longer than this
SYNC_GRACE_SECONDS=10
